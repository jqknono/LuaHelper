{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "LuaHelper-Debug",
            "request": "launch",
            "name": "Linux agent-4.x Lua",
            "cwd": "${fileDirname}",
            "luaFileExtension": "lua",
            "connectionPort": 8818,
            "stopOnEntry": true,
            "autoPathMode": false,
            "program": "/titan/agent/bin/titanagent",
            "args": [
                "-a",
                "-c",
                "-l",
                "-u",
                "'${file}'"
            ]
        },
        {
            "type": "lua",
            "request": "launch",
            "name": "Debug",
            "program": "${workspaceFolder}/test.example.lua"
        }
    ]
}